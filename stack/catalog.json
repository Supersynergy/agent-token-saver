{
  "schema_version": 2,
  "updated": "2026-09-10",
  "installer": "scripts/install_stack_tools.sh",
  "profiles": {
    "minimal": [
      "native-projection"
    ],
    "lean": [
      "native-projection",
      "skill-router",
      "rtk",
      "tilth"
    ],
    "teams": [
      "native-projection",
      "skill-router",
      "rtk",
      "tilth"
    ],
    "heavy": [
      "native-projection",
      "skill-router",
      "rtk",
      "tilth",
      "context-mode",
      "graphify",
      "codegraph"
    ]
  },
  "tools": {
    "native-projection": {
      "kind": "builtin",
      "required": true,
      "activation": "default",
      "purpose": "Deterministic filter, dedupe and bounded projection before model context"
    },
    "skill-router": {
      "kind": "path",
      "required": false,
      "paths": [
        "~/.local/bin/si",
        "~/.local/bin/agent-skill-route",
        "~/.codex/skills/agent-token-saver-skill-router/scripts/agent_token_saver.py",
        "~/.claude/skills/agent-token-saver-skill-router/scripts/agent_token_saver.py"
      ],
      "source": "https://github.com/Supersynergy/agent-token-saver-skill-router",
      "activation": "prompt-gated",
      "purpose": "Load zero or one primary skill automatically",
      "install": "curl -fsSL https://raw.githubusercontent.com/Supersynergy/agent-token-saver-skill-router/main/install.sh | bash -s -- all",
      "install_method": "curl",
      "needs": "a SKILL.md tree to index (~/.claude/skills, ~/.codex/skills, ~/.agents/skills, ...)"
    },
    "rtk": {
      "kind": "command",
      "required": false,
      "command": "rtk",
      "version_args": [
        "--version"
      ],
      "source": "https://github.com/rtk-ai/rtk",
      "activation": "native Claude hook or agent-guided CLI",
      "purpose": "Compress supported noisy shell output",
      "install": "brew install rtk (macOS) or cargo install rtk --locked (Linux)",
      "install_method": "brew_or_cargo",
      "host_wiring": {
        "claude": "PreToolUse Bash -> rtk hook claude",
        "codex": "PreToolUse Bash -> rtk hook codex (if supported)"
      }
    },
    "tilth": {
      "kind": "command",
      "required": false,
      "command": "tilth",
      "version_args": [
        "--version"
      ],
      "source": "https://github.com/jahala/tilth",
      "activation": "CLI or one lean MCP",
      "purpose": "Budgeted structural code retrieval (AST, 16 tree-sitter languages)",
      "install": "cargo install tilth --locked --force",
      "install_method": "cargo"
    },
    "context-mode": {
      "kind": "command",
      "required": false,
      "command": "context-mode",
      "version_args": [
        "doctor"
      ],
      "source": "https://github.com/mksglu/context-mode",
      "activation": "session/on demand",
      "purpose": "Sandbox and search large repeated payloads (FTS5)",
      "install": "npm install -g context-mode (or bun install -g context-mode)",
      "install_method": "npm_or_bun",
      "host_wiring": {
        "claude": "Claude Code plugin cache (~/.claude/plugins/cache/context-mode/)"
      }
    },
    "graphify": {
      "kind": "command",
      "required": false,
      "command": "graphify",
      "version_args": [
        "--version"
      ],
      "source": "https://github.com/Graphify-Labs/graphify",
      "activation": "build once, query on demand",
      "purpose": "Persistent corpus graph and relationship paths",
      "install": "uv tool install graphifyy (or pip install --user graphifyy)",
      "install_method": "uv_or_pip",
      "post_install": "graphify install --platform {claude,codex,hermes,opencode}",
      "host_wiring": {
        "claude": "graphify install --platform claude",
        "codex": "graphify install --platform codex",
        "hermes": "graphify install --platform hermes",
        "opencode": "graphify install --platform opencode"
      }
    },
    "codegraph": {
      "kind": "command",
      "required": false,
      "command": "codegraph",
      "version_args": [
        "version"
      ],
      "source": "https://github.com/colbymchenry/codegraph",
      "activation": "on demand",
      "purpose": "Callers, callees and impact analysis (MCP server)",
      "install": "curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh",
      "install_method": "curl_script",
      "post_install": "codegraph install --platform {claude,codex} --yes",
      "host_wiring": {
        "claude": "codegraph install --platform claude --yes",
        "codex": "codegraph install --platform codex --yes"
      }
    }
  }
}
