#!/usr/bin/env bash
# devincontrol — thin control wrapper around the Devin/Windsurf CLI (chisel).
#
# The Devin CLI ships headless inside Devin.app but is not on PATH by default.
# This wrapper finds it, defaults to a FREE model (GLM-5.2 High), and exposes
# the operations you actually use: ask (one-shot), chat (interactive), list
# and show existing sessions, models, and auth. Fail-open, no dependencies
# beyond sqlite3 (already on macOS).
#
# Default model: glm-5-2 (GLM-5.2 High, free). Alternatives: --swe (swe-1-7,
# free beta, faster) or --model <id> (see `devincontrol models`).
#
# Usage:
#   devincontrol ask "<prompt>"        one-shot print (default glm-5-2)
#   devincontrol ask --swe "<prompt>"  one-shot via SWE-1.7 Max
#   devincontrol ask --model <id> "…"  one-shot via a specific model
#   devincontrol chat                  interactive session
#   devincontrol list                  local sessions (id · title · date)
#   devincontrol show <id>             replay a session's messages
#   devincontrol models                available models (free ones flagged)
#   devincontrol auth                  login / status
#   devincontrol which                 print the resolved devin binary path

set -euo pipefail

DEFAULT_MODEL="${DEVINCONTROL_MODEL:-glm-5-2}"
SESS_DB="${DEVIN_SESSIONS_DB:-$HOME/.local/share/devin/cli/sessions.db}"

_devin_bin() {
  if command -v devin >/dev/null 2>&1; then command -v devin; return 0; fi
  local app="/Applications/Devin.app/Contents/Resources/app/extensions/windsurf/devin/bin/devin"
  [[ -x "$app" ]] && { echo "$app"; return 0; }
  echo "devincontrol: devin CLI not found (install Devin.app or put devin on PATH)" >&2
  return 1
}

cmd="${1:-help}"; shift 2>/dev/null || true
DEVIN="$(_devin_bin)" || exit 1

case "$cmd" in
  ask)
    model="$DEFAULT_MODEL"
    while [[ "${1:-}" == --* ]]; do
      case "$1" in
        --swe) model="swe-1-7"; shift ;;
        --model) model="$2"; shift 2 ;;
        *) break ;;
      esac
    done
    [[ $# -ge 1 ]] || { echo 'usage: devincontrol ask [--swe|--model <id>] "<prompt>"' >&2; exit 1; }
    exec "$DEVIN" --print --model "$model" -- "$*"
    ;;
  chat)
    model="$DEFAULT_MODEL"
    [[ "${1:-}" == --model ]] && { model="$2"; shift 2; }
    exec "$DEVIN" --model "$model" "$@"
    ;;
  list|ls)
    [[ -f "$SESS_DB" ]] || { echo "no local sessions db at $SESS_DB"; exit 0; }
    sqlite3 -header -column "$SESS_DB" \
      "SELECT substr(id,1,14) AS id, substr(title,1,50) AS title,
              datetime(created_at,'unixepoch','localtime') AS created
       FROM sessions ORDER BY created_at DESC LIMIT 30;" 2>/dev/null \
      || echo "devincontrol: could not read $SESS_DB"
    ;;
  show)
    [[ $# -ge 1 ]] || { echo "usage: devincontrol show <id-prefix>" >&2; exit 1; }
    [[ -f "$SESS_DB" ]] || { echo "no local sessions db"; exit 1; }
    sqlite3 "$SESS_DB" \
      "SELECT chat_message FROM message_nodes
       WHERE session_id LIKE '$1%' ORDER BY node_id LIMIT 40;" 2>/dev/null \
      || echo "devincontrol: no messages for '$1' (schema may differ across versions)"
    ;;
  models)
    "$DEVIN" models list 2>&1 | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g'
    ;;
  auth)
    "$DEVIN" auth "${1:-status}"
    ;;
  which)
    echo "$DEVIN"
    ;;
  help|--help|-h|*)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
