#!/usr/bin/env bash
# ats-pipe — one-shot research→reason pipeline: GATHER context with the
# cheapest recon tool, then FAN OUT the question across every $0 agent lane.
#
# Bundles the tools you already have into a single entry point:
#   GATHER : ats-recon (gmax/ghx/supacrawl) · superweb (web) · ghmax (github)
#   FANOUT : ats-swarm-bench --prompt -   (11 free/subscription/local models)
#
# Each stage is fail-open: a dead gather tool degrades to no-context, a dead
# lane is reported honestly by the swarm. No paid calls unless you add one.
#
# Usage:
#   ats-pipe "<question>"                 auto: local gather (ats-recon) → fanout
#   ats-pipe --web "<question>"           gather via superweb research
#   ats-pipe --github "<query>"           gather via ghmax code recon
#   ats-pipe --url <url> "<question>"     gather a page, ask about it
#   ats-pipe --gather-only "<q>"          just the context (no fanout)
#   ats-pipe --synth "<q>"                fan out, then merge into one consensus
#   ats-pipe --lanes free|local|all "<q>" pick the lane group (llmadapter)
#   ats-pipe --first 3 "<q>"              hedged race: stop after 3 answers
#   ats-pipe --only <lane> "<q>"          one lane/group
#
# Full pipeline: GATHER (recon) → FANOUT → SYNTH. `llmadapter` runs the bounded
# worker mode (three lanes by default); the Python swarm-bench is the explicit
# wide-fanout fallback + metrics/jury tool. Pick
# with --engine auto|llmadapter|swarm. Swarm-only flags: --system/--workers/--timeout.
#
# Flags after the question pass through to ats-swarm-bench (--only/--skip/
# --system/--workers/--timeout). `--fanout` makes a wide llmadapter run explicit.
# Config: ATS_PIPE_SWARM points at the bench.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
SWARM="${ATS_PIPE_SWARM:-$HERE/ats-swarm-bench.py}"

# Prefers ghx for github blobs, else supacrawl, else superweb fetch (fast tier).
_ats_pipe_scrape() {
  local u="$1"
  if [[ "$u" =~ github\.com/([^/]+/[^/]+)/blob/[^/]+/(.+) ]] && command -v ghx >/dev/null 2>&1; then
    ghx read "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" 2>/dev/null && return 0
  fi
  supacrawl scrape "$u" --format markdown 2>/dev/null && return 0
  command -v superweb >/dev/null 2>&1 && superweb fetch "$u" --mode auto --max-tier 1 2>/dev/null
}

mode="local" url="" gather_only=0 synth=0 verify=0 tier=0 recall=0 fanout=0
lanes="free" first="" engine="${ATS_PIPE_ENGINE:-auto}"
verify_lane="${ATS_PIPE_VERIFY_LANE:-nemotron-3-super-120b-a12b}"
swarm_passthru=() words=()
# Flags may appear anywhere (before or after the question); everything that is
# not a recognised flag is joined into the question.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --web) mode="web"; shift ;;
    --github|--gh) mode="github"; shift ;;
    --url) mode="url"; url="$2"; shift 2 ;;
    --gather-only) gather_only=1; shift ;;
    --synth) synth=1; shift ;;
    --verify) verify=1; shift ;;
    --tier) tier=1; shift ;;
    --recall) recall=1; shift ;;
    --verify-lane) verify_lane="$2"; shift 2 ;;
    --lanes) lanes="$2"; shift 2 ;;         # llmadapter: free|paid|local|cli|all|name,…
    --only) lanes="$2"; shift 2 ;;           # alias for a single lane/group
    --first) first="$2"; shift 2 ;;          # hedged race: stop after N answers
    --fanout) fanout=1; shift ;;               # explicit wide llmadapter benchmark
    --engine) engine="$2"; shift 2 ;;        # auto|llmadapter|swarm
    --skip|--system|--workers|--timeout)
      swarm_passthru+=("$1" "$2"); shift 2 ;;  # swarm-engine only
    -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) words+=("$1"); shift ;;
  esac
done
[[ ${#words[@]} -ge 1 ]] || { echo 'usage: ats-pipe [--web|--github|--url <u>] "<question>"' >&2; exit 1; }
question="${words[*]}"

# --- RECALL (optional) — "your agents already solved this." Prepend past-
# session hits from Synapse (via ats-recall) so the fan-out builds on what you
# already worked out instead of re-deriving it. Compounds: every run feeds the
# corpus (synapse-ingest-cli-logs), every run can read it back.
recall_ctx=""
if [[ "$recall" == 1 ]] && command -v ats-recall >/dev/null 2>&1; then
  echo "· recall (past sessions) …" >&2
  recall_ctx="$(ats-recall --limit 4 "$question" 2>/dev/null | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | head -c 2500)"
fi

# --- GATHER -----------------------------------------------------------------
echo "· gather ($mode) …" >&2
context=""
case "$mode" in
  url)     context="$(_ats_pipe_scrape "$url" 2>/dev/null || true)" ;;
  web)     context="$(superweb research "$question" 2>/dev/null || superweb qa "$question" 2>/dev/null || true)" ;;
  github)  context="$(ghmax "$question" --format agent -n 8 2>/dev/null || true)" ;;
  local|*) context="$(ats-recon "$question" 2>/dev/null || true)" ;;
esac
# strip ansi + cap size so noisy tool output never floods the model context
context="$(printf '%s' "$context" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | head -c 6000)"
[[ -n "$recall_ctx" ]] && context="$recall_ctx

$context"
[[ -n "$context" ]] || echo "  (no context — fanning out on the question alone)" >&2

if [[ "$gather_only" == 1 ]]; then
  printf '%s\n' "$context"
  exit 0
fi

prompt="Question: $question

Context (from recon tools; may be empty):
$context

Answer concisely and specifically using the context where relevant."

# --- FAN OUT (engine = llmadapter, the fast cached one; swarm as fallback) ---
# llmadapter does fanout + --aggregate (consensus merge) itself, faster and
# cached; the Python swarm-bench stays for metrics/jury runs. --engine picks.
have_llm=0; command -v llmadapter >/dev/null 2>&1 && have_llm=1
[[ "$engine" == "auto" ]] && engine=$([[ $have_llm == 1 ]] && echo llmadapter || echo swarm)

if [[ "$engine" == "llmadapter" ]]; then
  # --verify (fresh-context verifier) and --tier (cheap-propose → aggregate →
  # verify) are implemented IN llmadapter — one engine, cached + ledgered.
  msg="lanes=$lanes bounded=3"; [[ "$fanout" == 1 ]] && msg="$msg +fanout"
  [[ "$synth" == 1 ]] && msg="$msg +aggregate"
  [[ "$verify" == 1 ]] && msg="$msg +verify"; [[ "$tier" == 1 ]] && msg="tier"
  [[ -n "$first" ]] && msg="$msg first=$first"
  echo "· fan out via llmadapter ($msg) …" >&2
  if [[ "$tier" == 1 ]]; then
    llm_args=(ask "$prompt" --tier)
  else
    llm_args=(ask "$prompt" --swarm --lanes "$lanes")
    [[ "$fanout" == 1 ]] && llm_args+=(--fanout)
    [[ "$synth" == 1 ]] && llm_args+=(--aggregate)
    [[ "$verify" == 1 ]] && llm_args+=(--verify)
    [[ -n "$verify_lane" ]] && [[ "$verify" == 1 ]] && export LLMADAPTER_VERIFY_LANE="$verify_lane"
    [[ -n "$first" ]] && llm_args+=(--first "$first")
  fi
  llmadapter "${llm_args[@]}"
  exit $?
fi

# Fallback engine: Python swarm-bench (--system/--workers/--timeout apply here).
echo "· fan out via swarm (\$0 lanes) …" >&2
# Map a specific lane name to the swarm's --only (group keywords don't apply).
case "$lanes" in
  free|paid|local|cli|all) : ;;
  *) swarm_passthru+=(--only "$lanes") ;;
esac
[[ "$synth" == 1 ]] && swarm_passthru+=(--sample-chars 4000)
printf '%s' "$prompt" | python3 "$SWARM" --iter 1 --prompt - "${swarm_passthru[@]}"
